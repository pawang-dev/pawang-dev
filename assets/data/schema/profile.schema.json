    },
    "layout": {
     "enum": [
      "card",
      "row"
     ],
     "description": "card = kartu berkelompok, row = baris ikon tanpa kartu"
    },
    "title": {
     "type": "string",
     "description": "Judul",
     "maxLength": 40
    },
