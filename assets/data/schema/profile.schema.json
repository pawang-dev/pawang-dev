      "oneOf": [
       {
        "$ref": "#/definitions/skillName"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "name": {
          "$ref": "#/definitions/skillName"
         },
         "label": {
          "type": "string",
          "description": "Teks yang tampil"
         },
         "custom": {
          "type": "string",
          "description": "Nama file di assets/images/skills/"
         }
        }
       }
      ]
     },
     "maxItems": 60
    },
    "groups": {
     "type": "object",
     "description": "Nama grup: daftar skill",
